<Window x:Class="CybersecurityChatbot.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CUERER - Cybersecurity Awareness Bot" Height="650" Width="850"
        Background="#0B192E" Loaded="Window_Loaded">  
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Section -->
            <RowDefinition Height="*"/>    <!-- Chat History Section -->
            <RowDefinition Height="Auto"/> <!-- Input Section -->
        </Grid.RowDefinitions>

        <!-- 1. Decorated Header with Glow Effect -->
        <Border Grid.Row="0" Background="#16213E" CornerRadius="10" Padding="15" Margin="0,0,0,15" BorderBrush="Cyan" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🛡️ CUERER 🛡️" 
                           Foreground="Cyan" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" 
                           FontFamily="Segoe UI Black">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Cyan" BlurRadius="10" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Your Intelligent Cybersecurity Guardian" 
                           Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,5" Opacity="0.7"/>
                <TextBlock x:Name="AsciiDisplay" 
                           Foreground="Cyan" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 2. Chat Display (RichTextBox for multiple colors ) -->
        <Border Grid.Row="1" Background="#1A1A2E" CornerRadius="10" BorderBrush="#2A2A4E" BorderThickness="1">
            <ScrollViewer x:Name="ChatScroller" VerticalScrollBarVisibility="Auto" Padding="15">
                <!-- RichTextBox is used here to allow different colors for Bot and User -->
                <RichTextBox x:Name="ChatDisplay" Background="Transparent" Foreground="White" 
                             BorderThickness="0" IsReadOnly="True" FontSize="15" FontFamily="Segoe UI">
                    <FlowDocument>
                        <Paragraph>
                            <Run Text=""/>
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
            </ScrollViewer>
        </Border>

        <!-- 3. Input Area at the Bottom -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="UserInput" Grid.Column="0" Height="45" 
                     Background="#16213E" Foreground="White" BorderBrush="Cyan" 
                     VerticalContentAlignment="Center" Padding="15,0" FontSize="15"
                     KeyDown="UserInput_KeyDown" CaretBrush="Cyan"/>
            
            <Button Content="SEND MESSAGE" Grid.Column="1" Width="140" Margin="15,0,0,0" 
                    Background="Cyan" Foreground="#0B192E" FontWeight="Bold" FontSize="13"
                    Click="SendButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
