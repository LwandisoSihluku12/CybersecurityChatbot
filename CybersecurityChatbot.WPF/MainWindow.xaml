<Window x:Class="CybersecurityChatbot.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CUERER Bot" Height="600" Width="800" Background="#0B192E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="CUERER - STAY SAFE ONLINE" Foreground="Cyan" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock x:Name="AsciiDisplay" Foreground="Cyan" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer x:Name="ChatScroller" Grid.Row="1" Background="#16213E" Padding="10">
            <TextBlock x:Name="ChatDisplay" Foreground="White" TextWrapping="Wrap" FontSize="14"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UserInput" Grid.Column="0" Height="40" Background="#1A1A2E" Foreground="White" KeyDown="UserInput_KeyDown"/>
            <Button Content="SEND" Grid.Column="1" Width="80" Margin="10,0,0,0" Click="SendButton_Click" Background="Cyan"/>
        </Grid>
    </Grid>
</Window>
