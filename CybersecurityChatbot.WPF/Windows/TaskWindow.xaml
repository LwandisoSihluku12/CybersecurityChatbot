<!-- Windows/TaskWindow.xaml -->
<Window x:Class="CybersecurityChatbot.WPF.Windows.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Tasks" Height="450" Width="600" Background="#0B192E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Your Cybersecurity Tasks" Foreground="Cyan" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ListView x:Name="TaskListView" Grid.Row="1" Background="#1A1A2E" Foreground="White" BorderBrush="#2A2A4E" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="40"/>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="150"/>
                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="200"/>
                    <GridViewColumn Header="Reminder" DisplayMemberBinding="{Binding ReminderDisplay}" Width="120"/>
                    <GridViewColumn Header="Completed" DisplayMemberBinding="{Binding IsCompleted}" Width="70"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Refresh" Click="RefreshButton_Click" Width="80" Height="30" Margin="5,0" Background="Cyan" Foreground="#0B192E" FontWeight="Bold"/>
            <Button Content="Add New" Click="AddNewButton_Click" Width="80" Height="30" Margin="5,0" Background="Cyan" Foreground="#0B192E" FontWeight="Bold"/>
            <Button Content="Complete" Click="CompleteButton_Click" Width="80" Height="30" Margin="5,0" Background="Cyan" Foreground="#0B192E" FontWeight="Bold"/>
            <Button Content="Delete" Click="DeleteButton_Click" Width="80" Height="30" Margin="5,0" Background="Red" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>