<!-- Windows/QuizWindow.xaml -->
<Window x:Class="CybersecurityChatbot.WPF.Windows.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz" Height="500" Width="700" Background="#0B192E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="QuestionTextBlock" Grid.Row="0" TextWrapping="Wrap" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel x:Name="OptionsPanel" Grid.Row="1" Margin="0,0,0,15">
            <!-- Options will be dynamically added here -->
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SubmitButton" Content="Submit Answer" Click="SubmitButton_Click" Width="120" Height="35" Margin="5,0" Background="Cyan" Foreground="#0B192E" FontWeight="Bold"/>
            <Button x:Name="NextButton" Content="Next Question" Click="NextButton_Click" Width="120" Height="35" Margin="5,0" Background="DarkGray" Foreground="White" FontWeight="Bold" IsEnabled="False"/>
            <Button x:Name="RestartButton" Content="Restart Quiz" Click="RestartButton_Click" Width="120" Height="35" Margin="5,0" Background="Red" Foreground="White" FontWeight="Bold" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>